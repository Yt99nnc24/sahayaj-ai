SAHAYAJ_SECRET=
SAHAYAJ_DOCTOR_CODE=replace-with-a-private-registration-code
SAHAYAJ_SECURE_COOKIE=0
SAHAYAJ_PORT=5000
# auto: local Ollama when available, otherwise a limited bundled helper.
# basic: bundled helper only (no network requests at all).
# ollama: require the downloaded local model; show setup error if unavailable.
SAHAYAJ_AI_MODE=auto
SAHAYAJ_LOCAL_MODEL=qwen2.5:1.5b
# Optional: SAHAYAJ_DATABASE=C:\path\to\instance\migrated.db
